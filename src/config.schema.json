{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rin-yato/differ/main/src/config.schema.json",
  "title": "gitcha config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "themeId": {
      "type": "string",
      "enum": [
        "amoled",
        "aura",
        "ayu",
        "carbonfox",
        "catppuccin",
        "catppuccin-frappe",
        "catppuccin-macchiato",
        "cobalt2",
        "cursor",
        "dracula",
        "everforest",
        "flexoki",
        "github",
        "gruvbox",
        "kanagawa",
        "lucent-orng",
        "material",
        "matrix",
        "mercury",
        "monokai",
        "nightowl",
        "nord",
        "oc-2",
        "one-dark",
        "onedarkpro",
        "opencode",
        "orng",
        "osaka-jade",
        "palenight",
        "rosepine",
        "shadesofpurple",
        "solarized",
        "synthwave84",
        "tokyonight",
        "vercel",
        "vesper",
        "zenburn"
      ]
    },
    "sidebarWidth": {
      "type": "integer",
      "minimum": 20,
      "maximum": 80
    },
    "padding": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "keybindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openCommandPalette": { "$ref": "#/$defs/shortcutList" },
        "moveUp": { "$ref": "#/$defs/shortcutList" },
        "moveDown": { "$ref": "#/$defs/shortcutList" },
        "toggleDiffView": { "$ref": "#/$defs/shortcutList" },
        "refresh": { "$ref": "#/$defs/shortcutList" },
        "openCompareDialog": { "$ref": "#/$defs/shortcutList" },
        "stageSelectedFile": { "$ref": "#/$defs/shortcutList" },
        "unstageSelectedFile": { "$ref": "#/$defs/shortcutList" },
        "discardSelectedFile": { "$ref": "#/$defs/shortcutList" },
        "shrinkSidebar": { "$ref": "#/$defs/shortcutList" },
        "growSidebar": { "$ref": "#/$defs/shortcutList" },
        "toggleSidebar": { "$ref": "#/$defs/shortcutList" },
        "openThemeDialog": { "$ref": "#/$defs/shortcutList" },
        "openStatusDialog": { "$ref": "#/$defs/shortcutList" },
        "upgradeApp": { "$ref": "#/$defs/shortcutList" },
        "quit": { "$ref": "#/$defs/shortcutList" }
      }
    }
  },
  "$defs": {
    "shortcutList": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      ]
    }
  }
}
