{
  "name": "changes",
  "version": "0.1.0",
  "description": "A terminal UI for reviewing code changes with syntax highlighting",
  "type": "module",
  "bin": {
    "changes": "dist/changes"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun run scripts/build.ts",
    "install": "bun run scripts/install.ts",
    "bench": "bun run scripts/bench.ts",
    "bench:repo": "bun run scripts/bench.ts --repo-url=https://github.com/anomalyco/opentui",
    "bench:json": "bun run scripts/bench.ts --json",
    "bench:reset-fixture": "bun run scripts/bench-reset-fixture.ts",
    "bench:latest": "bun run bench --json --out=benchmarks/latest.json",
    "bench:compare": "bun run bench --baseline=benchmarks/latest.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write --unsafe",
    "ci": "bun run check && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "lefthook": "^2.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.1.97",
    "@opentui/react": "^0.1.97",
    "diff": "^8.0.2",
    "fuzzysort": "^3.1.0",
    "react": "^19.0.0",
    "remeda": "^2.33.7"
  },
  "keywords": [
    "git",
    "review",
    "cli",
    "terminal",
    "diff",
    "tui"
  ],
  "license": "MIT"
}
