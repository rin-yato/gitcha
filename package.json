{
  "name": "sourcery",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.1.92",
    "@opentui/solid": "^0.1.92",
    "solid-js": "^1.9.12"
  },
  "scripts": {
    "dev": "bun run --hot src/index.tsx",
    "build": "bun run scripts/build.ts",
    "install:local": "bun run scripts/install.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write --unsafe",
    "ci": "bun run check && bun run typecheck"
  }
}
