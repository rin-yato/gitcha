{
  "name": "gitcha",
  "version": "0.1.11",
  "homepage": "https://github.com/rin-yato/gitcha#readme",
  "bugs": {
    "url": "https://github.com/rin-yato/gitcha/issues"
  },
  "author": {
    "name": "Rin Yato",
    "url": "https://github.com/rin-yato"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rin-yato/gitcha.git"
  },
  "description": "A terminal UI for reviewing code changes with syntax highlighting",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gitcha": "dist/index.js",
    "gc": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "build:matrix": "bun run scripts/build-matrix.ts",
    "setup": "bun run build && bun link",
    "release": "release-it -i patch",
    "preview": "bun run dist/index.js",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write --unsafe",
    "ci": "bun run check && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/bun": "1.3.14",
    "conventional-commits-filter": "^5.0.0",
    "conventional-commits-parser": "^6.4.0",
    "lefthook": "^2.1.9",
    "release-it": "^20.2.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@opentui/core": "^0.3.0",
    "@opentui/keymap": "^0.3.0",
    "@opentui/solid": "^0.3.0",
    "better-result": "^2.9.2",
    "chokidar": "^5.0.0",
    "dequal": "^2.0.3",
    "diff": "^9.0.0",
    "fuzzysort": "^3.1.0",
    "isbinaryfile": "^6.0.0",
    "meow": "^14.1.0",
    "remeda": "^2.37.0",
    "solid-js": "^1.9.13",
    "zod": "^4.4.3"
  },
  "release-it": {
    "git": {
      "tagName": "v${version}",
      "commitMessage": "chore(release): v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "release": false,
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "keywords": [
    "git",
    "review",
    "cli",
    "terminal",
    "diff",
    "tui"
  ],
  "license": "MIT"
}
