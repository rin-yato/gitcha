{
  "name": "gitcha",
  "version": "0.1.8",
  "description": "A terminal UI for reviewing code changes with syntax highlighting",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gitcha": "dist/index.js",
    "gc": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun run scripts/build.ts",
    "setup": "bun run build && bun link",
    "release": "release-it -i patch",
    "preview": "bun run dist/index.js",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write --unsafe",
    "ci": "bun run check && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "lefthook": "^2.1.6",
    "release-it": "^20.0.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@opentui/core": "^0.2.2",
    "@opentui/keymap": "^0.2.2",
    "@opentui/solid": "^0.2.2",
    "better-result": "^2.9.2",
    "chokidar": "^5.0.0",
    "dequal": "^2.0.3",
    "diff": "^9.0.0",
    "fuzzysort": "^3.1.0",
    "isbinaryfile": "^6.0.0",
    "meow": "^14.1.0",
    "remeda": "^2.34.0",
    "solid-js": "^1.9.12"
  },
  "release-it": {
    "git": {
      "tagName": "v${version}",
      "commitMessage": "chore(release): v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "release": false,
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "keywords": [
    "git",
    "review",
    "cli",
    "terminal",
    "diff",
    "tui"
  ],
  "license": "MIT"
}
