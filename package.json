{
  "name": "sourcery",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "latest",
    "@types/react": "^19.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.1.96",
    "@opentui/react": "^0.1.96",
    "react": "^19.0.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "dev:git": "USE_REAL_GIT=1 bun run dev",
    "build": "bun run scripts/build.ts",
    "install:local": "bun run scripts/install.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write --unsafe",
    "ci": "bun run check && bun run typecheck"
  }
}
