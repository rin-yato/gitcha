{
  "name": "changes",
  "version": "0.1.0",
  "description": "A terminal UI for reviewing code changes with syntax highlighting",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "changes": "dist/index.js",
    "ch": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun run scripts/build.ts",
    "setup": "bun run build && bun link",
    "release": "release-it",
    "preview": "bun run dist/index.js",
    "bench": "bun run benchmarks/bench.ts",
    "bench:latest": "bun run benchmarks/bench.ts --json --write-latest",
    "bench:compare": "bun run benchmarks/bench-compare.ts",
    "bench:reset-fixture": "bun run benchmarks/bench-reset-fixture.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write --unsafe",
    "ci": "bun run check && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@release-it/conventional-changelog": "^8.0.1",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "lefthook": "^2.1.5",
    "release-it": "^20.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.1.99",
    "@opentui/react": "^0.1.99",
    "dequal": "^2.0.3",
    "diff": "^8.0.2",
    "fuzzysort": "^3.1.0",
    "react": "^19.0.0",
    "remeda": "^2.33.7"
  },
  "release-it": {
    "git": {
      "tagName": "v${version}",
      "commitMessage": "chore(release): v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "release": false,
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "keywords": [
    "git",
    "review",
    "cli",
    "terminal",
    "diff",
    "tui"
  ],
  "license": "MIT"
}
