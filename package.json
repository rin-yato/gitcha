{
  "name": "gitcha",
  "version": "0.1.7",
  "description": "A terminal UI for reviewing code changes with syntax highlighting",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gitcha": "dist/index.js",
    "gc": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun run scripts/build.ts",
    "setup": "bun run build && bun link",
    "release": "release-it -i patch",
    "preview": "bun run dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write --unsafe",
    "ci": "bun run check && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@release-it/conventional-changelog": "^8.0.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "lefthook": "^2.1.6",
    "release-it": "^20.0.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.1.103",
    "@opentui/react": "^0.1.103",
    "better-result": "^2.9.0",
    "chokidar": "^5.0.0",
    "dequal": "^2.0.3",
    "diff": "^8.0.4",
    "fuzzysort": "^3.1.0",
    "isbinaryfile": "^6.0.0",
    "meow": "^14.1.0",
    "react": "^19.2.5",
    "remeda": "^2.33.7"
  },
  "release-it": {
    "git": {
      "tagName": "v${version}",
      "commitMessage": "chore(release): v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "release": false,
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "keywords": [
    "git",
    "review",
    "cli",
    "terminal",
    "diff",
    "tui"
  ],
  "license": "MIT"
}
